<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/rota_white">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="9dp">
        <ImageView
            android:id="@+id/actionBack"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="13dp"
            android:src="@drawable/ic_rota_back"
            android:tint="@color/rota_navy"
            android:contentDescription="@string/TextBack"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rota_publish_item"
            android:textColor="@color/rota_navy"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fillViewport="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:paddingBottom="8dp">
            <TextView
                android:id="@+id/inputItemTitleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:text="@string/TextItemTitle"
                android:textColor="@color/rota_navy"
                android:textSize="13sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/inputItemTitle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_field"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:gravity="center_vertical|start"
                android:textSize="14sp"
                android:textColor="@color/rota_navy"
                android:textColorHint="@color/rota_gray"
                android:hint="@string/rota_title_hint"
                android:inputType="textCapSentences"
                android:singleLine="true" />
            <TextView
                android:id="@+id/inputItemCategoryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:layout_marginBottom="5dp"
                android:text="@string/TextCategory"
                android:textColor="@color/rota_navy"
                android:textSize="13sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/inputItemCategory"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_field"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:gravity="center_vertical|start"
                android:textSize="14sp"
                android:textColor="@color/rota_navy"
                android:textColorHint="@color/rota_gray"
                android:hint="@string/rota_category_hint"
                android:focusable="false"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_rota_chevron_down"
                android:drawablePadding="8dp" />
            <TextView
                android:id="@+id/inputItemConditionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:layout_marginBottom="5dp"
                android:text="@string/TextStatus"
                android:textColor="@color/rota_navy"
                android:textSize="13sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/inputItemCondition"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_field"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:gravity="center_vertical|start"
                android:textSize="14sp"
                android:textColor="@color/rota_navy"
                android:textColorHint="@color/rota_gray"
                android:hint="@string/rota_condition_hint"
                android:focusable="false"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_rota_chevron_down"
                android:drawablePadding="8dp" />
            <TextView
                android:id="@+id/inputItemDescriptionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:layout_marginBottom="5dp"
                android:text="@string/TextDescription"
                android:textColor="@color/rota_navy"
                android:textSize="13sp"
                android:textStyle="bold" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="97dp">
                <EditText
                    android:id="@+id/inputItemDescription"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_field"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:paddingTop="11dp"
                    android:paddingBottom="27dp"
                    android:gravity="top|start"
                    android:textSize="14sp"
                    android:textColor="@color/rota_navy"
                    android:textColorHint="@color/rota_gray"
                    android:hint="@string/rota_description_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="500" />
                <TextView
                    android:id="@+id/descriptionCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="8dp"
                    tools:text="0/500"
                    android:textColor="@color/rota_gray"
                    android:textSize="11sp" />
            </FrameLayout>
            <TextView
                android:id="@+id/inputItemAreaLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:layout_marginBottom="5dp"
                android:text="@string/rota_area"
                android:textColor="@color/rota_navy"
                android:textSize="13sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/inputItemArea"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_field"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:gravity="center_vertical|start"
                android:textSize="14sp"
                android:textColor="@color/rota_navy"
                android:textColorHint="@color/rota_gray"
                android:hint="@string/rota_area_hint"
                android:focusable="false"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_rota_chevron_down"
                android:drawablePadding="8dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">
                <TextView
                    android:id="@+id/photosTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/TextItemPhotos"
                    android:textSize="13sp"
                    android:textColor="@color/rota_navy"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/photoCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="2/3"
                    android:textSize="12sp"
                    android:textColor="@color/rota_gray" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <LinearLayout
                    android:id="@+id/actionTakePhoto"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_field"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_marginEnd="7dp"
                        android:src="@drawable/ic_rota_camera"
                        android:contentDescription="@null" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/TextTakePhoto"
                        android:textSize="12sp"
                        android:textColor="@color/rota_navy" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/actionGallery"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_field"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_marginEnd="7dp"
                        android:src="@drawable/ic_rota_gallery"
                        android:contentDescription="@null" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/TextChooseFromGallery"
                        android:textSize="12sp"
                        android:textColor="@color/rota_navy" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/photoSlots"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:orientation="horizontal"
                android:layout_marginTop="9dp">
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/bg_photo_slot"
                    android:clipToOutline="true">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/photo_bicycle"
                        android:contentDescription="@string/TextItemPhotos" />
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_rota_remove_photo"
                        android:src="@drawable/ic_rota_close"
                        android:padding="5dp"
                        android:contentDescription="@string/TextRemovePhoto" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/bg_photo_slot"
                    android:clipToOutline="true">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/photo_bicycle_gears"
                        android:contentDescription="@string/TextItemPhotos" />
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_rota_remove_photo"
                        android:src="@drawable/ic_rota_close"
                        android:padding="5dp"
                        android:contentDescription="@string/TextRemovePhoto" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_photo_slot_dashed">
                    <ImageView
                        android:layout_width="31dp"
                        android:layout_height="31dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_rota_plus_circle"
                        android:tint="@color/rota_gray"
                        android:contentDescription="@string/TextPhotoAdd" />
                </FrameLayout>
            </LinearLayout>
            <CheckBox
                android:id="@+id/checkAgreement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:buttonTint="@color/rota_green"
                android:text="@string/TextAgreedMeetingPoint"
                android:textSize="12sp"
                android:textColor="@color/rota_navy" />
        </LinearLayout>
    </ScrollView>
    <TextView
        android:id="@+id/actionPublishItem"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="17dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_primary"
        android:gravity="center"
        android:text="@string/TextPublish"
        android:textColor="@color/rota_white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
