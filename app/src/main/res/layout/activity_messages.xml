
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/TextMessages"
            android:textSize="29sp"
            android:textStyle="bold"
            android:textColor="@color/rota_navy" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="17dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_pill"
            android:elevation="2dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_rota_search"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/inputSearchMessages"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:paddingEnd="5dp"
                android:background="@android:color/transparent"
                android:hint="@string/rota_search_conversation"
                android:textColor="@color/rota_navy"
                android:textColorHint="@color/rota_gray"
                android:textSize="13sp"
                android:singleLine="true"
                android:inputType="text" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/bg_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/conv0Root"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="10dp"
                android:background="@color/rota_white">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_rota_avatar_small"
                    android:background="@drawable/bg_avatar_circle"
                    android:padding="8dp"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="13dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/conv0Name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/rota_navy"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Ana" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/conv0Image"
                            android:layout_width="43dp"
                            android:layout_height="43dp"
                            android:scaleType="centerCrop"
                            android:background="@drawable/bg_photo_slot"
                            android:clipToOutline="true"
                            tools:src="@drawable/photo_bicycle"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/conv0Title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textColor="@color/rota_navy"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end"
                                tools:text="Bicicleta en buen estado" />

                            <TextView
                                android:id="@+id/conv0Snippet"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textSize="12sp"
                                android:textColor="@color/rota_gray"
                                android:maxLines="1"
                                android:ellipsize="end"
                                tools:text="Hola, ¿sigue disponible? Me interesa..." />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="57dp"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/conv0Time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="7dp"
                        android:textSize="11sp"
                        android:textColor="@color/rota_gray"
                        tools:text="9:15" />

                    <TextView
                        android:id="@+id/conv0Unread"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="23dp"
                        android:gravity="center"
                        android:background="@drawable/bg_pill_on"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/rota_white"
                        tools:text="2" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center_vertical|end"
                        android:src="@drawable/ic_rota_chevron_right"
                        android:contentDescription="@null" />

                </FrameLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/bg_divider" />

            <LinearLayout
                android:id="@+id/conv1Root"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="10dp"
                android:background="@color/rota_white">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_rota_avatar_small"
                    android:background="@drawable/bg_avatar_circle"
                    android:padding="8dp"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="13dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/conv1Name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/rota_navy"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Carlos" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/conv1Image"
                            android:layout_width="43dp"
                            android:layout_height="43dp"
                            android:scaleType="centerCrop"
                            android:background="@drawable/bg_photo_slot"
                            android:clipToOutline="true"
                            tools:src="@drawable/photo_fan"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/conv1Title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textColor="@color/rota_navy"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end"
                                tools:text="Abanico de pedestal" />

                            <TextView
                                android:id="@+id/conv1Snippet"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textSize="12sp"
                                android:textColor="@color/rota_gray"
                                android:maxLines="1"
                                android:ellipsize="end"
                                tools:text="Perfecto, ¿podemos vernos mañana?" />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="57dp"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/conv1Time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="7dp"
                        android:textSize="11sp"
                        android:textColor="@color/rota_gray"
                        tools:text="Ayer" />

                    <TextView
                        android:id="@+id/conv1Unread"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="23dp"
                        android:gravity="center"
                        android:background="@drawable/bg_pill_on"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/rota_white"
                        tools:text="1" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center_vertical|end"
                        android:src="@drawable/ic_rota_chevron_right"
                        android:contentDescription="@null" />

                </FrameLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/bg_divider" />

            <LinearLayout
                android:id="@+id/conv2Root"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="10dp"
                android:background="@color/rota_white">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_rota_avatar_small"
                    android:background="@drawable/bg_avatar_circle"
                    android:padding="8dp"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="13dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/conv2Name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/rota_navy"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Sofía" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/conv2Image"
                            android:layout_width="43dp"
                            android:layout_height="43dp"
                            android:scaleType="centerCrop"
                            android:background="@drawable/bg_photo_slot"
                            android:clipToOutline="true"
                            tools:src="@drawable/photo_baby"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/conv2Title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textColor="@color/rota_navy"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end"
                                tools:text="Ropa de bebé" />

                            <TextView
                                android:id="@+id/conv2Snippet"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textSize="12sp"
                                android:textColor="@color/rota_gray"
                                android:maxLines="1"
                                android:ellipsize="end"
                                tools:text="¡Muchas gracias! Me encantaría..." />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="57dp"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/conv2Time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="7dp"
                        android:textSize="11sp"
                        android:textColor="@color/rota_gray"
                        tools:text="Ayer" />

                    <TextView
                        android:id="@+id/conv2Unread"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="23dp"
                        android:gravity="center"
                        android:background="@drawable/bg_pill_on"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/rota_white"
                        android:visibility="invisible"
                        tools:text="" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center_vertical|end"
                        android:src="@drawable/ic_rota_chevron_right"
                        android:contentDescription="@null" />

                </FrameLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/bg_divider" />

            <LinearLayout
                android:id="@+id/conv3Root"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="10dp"
                android:background="@color/rota_white">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_rota_avatar_small"
                    android:background="@drawable/bg_avatar_circle"
                    android:padding="8dp"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="13dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/conv3Name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/rota_navy"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Diego" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/conv3Image"
                            android:layout_width="43dp"
                            android:layout_height="43dp"
                            android:scaleType="centerCrop"
                            android:background="@drawable/bg_photo_slot"
                            android:clipToOutline="true"
                            tools:src="@drawable/photo_books"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/conv3Title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textColor="@color/rota_navy"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end"
                                tools:text="Libros universitarios" />

                            <TextView
                                android:id="@+id/conv3Snippet"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textSize="12sp"
                                android:textColor="@color/rota_gray"
                                android:maxLines="1"
                                android:ellipsize="end"
                                tools:text="¿Están todos los libros incluidos?" />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="57dp"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/conv3Time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="7dp"
                        android:textSize="11sp"
                        android:textColor="@color/rota_gray"
                        tools:text="Lun" />

                    <TextView
                        android:id="@+id/conv3Unread"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="23dp"
                        android:gravity="center"
                        android:background="@drawable/bg_pill_on"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/rota_white"
                        android:visibility="invisible"
                        tools:text="" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center_vertical|end"
                        android:src="@drawable/ic_rota_chevron_right"
                        android:contentDescription="@null" />

                </FrameLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/bg_divider" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/navRoot"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:orientation="horizontal"
        android:background="@color/rota_white"
        android:elevation="4dp">

        <FrameLayout
            android:id="@+id/navExplore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navIconExplore"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rota_search"
                android:contentDescription="@string/rota_nav_explore"
                app:tint="@color/rota_gray" />

            <View
                android:id="@+id/navLineExplore"
                android:layout_width="29dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pill_on"
                android:visibility="gone" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/navPublish"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navIconPublish"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rota_plus_circle"
                android:contentDescription="@string/rota_nav_publish"
                app:tint="@color/rota_gray" />

            <View
                android:id="@+id/navLinePublish"
                android:layout_width="29dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pill_on"
                android:visibility="gone" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/navMessages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navIconMessages"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rota_chat"
                android:contentDescription="@string/rota_nav_messages"
                app:tint="@color/rota_green" />

            <View
                android:id="@+id/navLineMessages"
                android:layout_width="29dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pill_on"
                android:visibility="visible" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/navRequests"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navIconRequests"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rota_clipboard"
                android:contentDescription="@string/rota_nav_requests"
                app:tint="@color/rota_gray" />

            <View
                android:id="@+id/navLineRequests"
                android:layout_width="29dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pill_on"
                android:visibility="gone" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navIconProfile"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rota_person"
                android:contentDescription="@string/rota_nav_profile"
                app:tint="@color/rota_gray" />

            <View
                android:id="@+id/navLineProfile"
                android:layout_width="29dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pill_on"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
