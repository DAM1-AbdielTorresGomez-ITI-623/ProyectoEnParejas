
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFBFD">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="21dp">

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/TextRequests"
            android:textSize="29sp"
            android:textStyle="bold"
            android:textColor="@color/rota_navy" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/rota_requests_subtitle"
            android:textSize="14sp"
            android:textColor="@color/rota_gray" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="19dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_pill">

            <LinearLayout
                android:id="@+id/requestDirection0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_pill_on"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_rota_box"
                    android:tint="@color/rota_white"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/rota_received"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/rota_white" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/requestDirection1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_pill"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_rota_send"
                    android:tint="@color/rota_navy"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/rota_sent"
                    android:textSize="14sp"
                    android:textColor="@color/rota_navy" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="13dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/requestTab0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_on"
                android:gravity="center"
                android:text="@string/rota_pending"
                tools:text="Pendientes (3)"
                android:textColor="@color/rota_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/requestTab1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:text="@string/rota_accepted"
                tools:text="Aceptadas (2)"
                android:textColor="@color/rota_gray"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/requestTab2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:text="@string/TextFinished"
                tools:text="Finalizadas (4)"
                android:textColor="@color/rota_gray"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/request0Root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:padding="10dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/request0Image"
                        android:layout_width="126dp"
                        android:layout_height="126dp"
                        android:scaleType="fitCenter"
                        tools:src="@drawable/photo_bicycle"
                        android:background="@drawable/bg_photo_slot"
                        android:clipToOutline="true" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:id="@+id/request0Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="@color/rota_navy"
                            android:textStyle="bold"
                            tools:text="Bicicleta en buen estado"
                            android:maxLines="2" />

                        <TextView
                            android:id="@+id/request0User"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/rota_navy"
                            android:textStyle="bold"
                            tools:text="María"
                            android:drawableStart="@drawable/ic_rota_avatar_small"
                            android:drawablePadding="7dp"
                            android:layout_marginTop="9dp" />

                        <TextView
                            android:id="@+id/request0Time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/rota_gray"
                            tools:text="Hace 2 horas"
                            android:layout_marginTop="5dp" />

                        <TextView
                            android:id="@+id/request0Description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/rota_gray"
                            tools:text="¡Hola! Me interesa la bicicleta. ¿Sigue disponible? Podría recogerla este fin de semana."
                            android:layout_marginTop="7dp"
                            android:maxLines="4" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="9dp">

                    <LinearLayout
                        android:id="@+id/request0Accept"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_on"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="5dp">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_rota_check"
                            android:tint="@color/rota_white"
                            android:contentDescription="@null"
                            android:clickable="false"
                            android:focusable="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/TextAccept"
                            android:textColor="@color/rota_white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/request0Chat"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ghost"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_rota_chat"
                            android:tint="@color/rota_gray"
                            android:contentDescription="@null"
                            android:clickable="false"
                            android:focusable="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/TextViewChat"
                            android:textColor="@color/rota_gray"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/request0Cancel"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_red"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="6dp">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_rota_close"
                            android:tint="@color/rota_red"
                            android:contentDescription="@null"
                            android:clickable="false"
                            android:focusable="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/TextReject"
                            android:textColor="@color/rota_red"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/request1Root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:padding="10dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/request1Image"
                        android:layout_width="126dp"
                        android:layout_height="126dp"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/photo_fan"
                        android:background="@drawable/bg_photo_slot"
                        android:clipToOutline="true" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:id="@+id/request1Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="@color/rota_navy"
                            android:textStyle="bold"
                            tools:text="Abanico de pedestal"
                            android:maxLines="2" />

                        <TextView
                            android:id="@+id/request1User"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/rota_navy"
                            android:textStyle="bold"
                            tools:text="José"
                            android:drawableStart="@drawable/ic_rota_avatar_small"
                            android:drawablePadding="7dp"
                            android:layout_marginTop="9dp" />

                        <TextView
                            android:id="@+id/request1Time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/rota_gray"
                            tools:text="Hace 5 horas"
                            android:layout_marginTop="5dp" />

                        <TextView
                            android:id="@+id/request1Description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/rota_gray"
                            tools:text="Hola, me interesa el abanico. ¿Podría pasar mañana por la tarde? Vivo cerca."
                            android:layout_marginTop="7dp"
                            android:maxLines="4" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="9dp">

                    <LinearLayout
                        android:id="@+id/request1Accept"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_on"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="5dp">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_rota_check"
                            android:tint="@color/rota_white"
                            android:contentDescription="@null"
                            android:clickable="false"
                            android:focusable="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/TextAccept"
                            android:textColor="@color/rota_white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/request1Chat"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ghost"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_rota_chat"
                            android:tint="@color/rota_gray"
                            android:contentDescription="@null"
                            android:clickable="false"
                            android:focusable="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/TextViewChat"
                            android:textColor="@color/rota_gray"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/request1Cancel"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_red"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="6dp">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_rota_close"
                            android:tint="@color/rota_red"
                            android:contentDescription="@null"
                            android:clickable="false"
                            android:focusable="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/TextReject"
                            android:textColor="@color/rota_red"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/request2Root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:padding="10dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/request2Image"
                        android:layout_width="126dp"
                        android:layout_height="126dp"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/photo_baby"
                        android:background="@drawable/bg_photo_slot"
                        android:clipToOutline="true" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:id="@+id/request2Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="@color/rota_navy"
                            android:textStyle="bold"
                            tools:text="Ropa de bebé"
                            android:maxLines="2" />

                        <TextView
                            android:id="@+id/request2User"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/rota_navy"
                            android:textStyle="bold"
                            tools:text="Laura"
                            android:drawableStart="@drawable/ic_rota_avatar_small"
                            android:drawablePadding="7dp"
                            android:layout_marginTop="9dp" />

                        <TextView
                            android:id="@+id/request2Time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/rota_gray"
                            tools:text="Hace 1 día"
                            android:layout_marginTop="5dp" />

                        <TextView
                            android:id="@+id/request2Description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/rota_gray"
                            tools:text="Hola, me encantaría retirar la ropa de bebé. ¿La seguís teniendo? Puedo pasar el sábado."
                            android:layout_marginTop="7dp"
                            android:maxLines="4" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="9dp">

                    <LinearLayout
                        android:id="@+id/request2Accept"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_on"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="5dp">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_rota_check"
                            android:tint="@color/rota_white"
                            android:contentDescription="@null"
                            android:clickable="false"
                            android:focusable="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/TextAccept"
                            android:textColor="@color/rota_white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/request2Chat"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ghost"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_rota_chat"
                            android:tint="@color/rota_gray"
                            android:contentDescription="@null"
                            android:clickable="false"
                            android:focusable="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/TextViewChat"
                            android:textColor="@color/rota_gray"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/request2Cancel"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_red"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="6dp">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_rota_close"
                            android:tint="@color/rota_red"
                            android:contentDescription="@null"
                            android:clickable="false"
                            android:focusable="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/TextReject"
                            android:textColor="@color/rota_red"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/navRoot"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:orientation="horizontal"
        android:background="@color/rota_white"
        android:elevation="4dp">

        <FrameLayout
            android:id="@+id/navExplore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navIconExplore"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rota_search"
                android:contentDescription="@string/rota_nav_explore"
                android:tint="@color/rota_gray" />

            <View
                android:id="@+id/navLineExplore"
                android:layout_width="29dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pill_on"
                android:visibility="gone" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/navPublish"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navIconPublish"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rota_plus_circle"
                android:contentDescription="@string/rota_nav_publish"
                android:tint="@color/rota_gray" />

            <View
                android:id="@+id/navLinePublish"
                android:layout_width="29dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pill_on"
                android:visibility="gone" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/navMessages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navIconMessages"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rota_chat"
                android:contentDescription="@string/rota_nav_messages"
                android:tint="@color/rota_gray" />

            <View
                android:id="@+id/navLineMessages"
                android:layout_width="29dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pill_on"
                android:visibility="gone" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/navRequests"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navIconRequests"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rota_clipboard"
                android:contentDescription="@string/rota_nav_requests"
                android:tint="@color/rota_green" />

            <View
                android:id="@+id/navLineRequests"
                android:layout_width="29dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pill_on"
                android:visibility="visible" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navIconProfile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rota_person"
                android:contentDescription="@string/rota_nav_profile"
                android:tint="@color/rota_gray" />

            <View
                android:id="@+id/navLineProfile"
                android:layout_width="29dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pill_on"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
