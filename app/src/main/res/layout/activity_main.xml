
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:orientation="vertical"
    android:background="@color/rota_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="17dp"
        android:paddingBottom="4dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/logoExplore"
            android:layout_width="114dp"
            android:layout_height="50dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:src="@drawable/logo_rota"
            android:contentDescription="@string/app_name"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/TextSlogan"
            android:textColor="@color/rota_gray"
            android:textSize="13sp"
            android:layout_marginTop="1dp"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingBottom="10dp">

            <!-- BUSCADOR -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_field"
                android:elevation="1dp">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_rota_search"
                    android:contentDescription="@null"/>

                <EditText
                    android:id="@+id/inputSearchItems"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="@string/TextSearchItems"
                    android:singleLine="true"
                    android:background="@android:color/transparent"
                    android:paddingStart="13dp"
                    android:textSize="14sp"
                    android:textColor="@color/rota_navy"/>

            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="13dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:id="@+id/categoryFilters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/categoryChip0"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_pill"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:gravity="center"
                        android:text="@string/TextAll"
                        android:textSize="12sp"
                        android:textColor="@color/rota_gray"/>

                    <TextView
                        android:id="@+id/categoryChip1"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_pill"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:gravity="center"
                        android:text="@string/TextHome"
                        android:textSize="12sp"
                        android:textColor="@color/rota_gray"/>

                    <TextView
                        android:id="@+id/categoryChip2"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_pill"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:gravity="center"
                        android:text="@string/TextBaby"
                        android:textSize="12sp"
                        android:textColor="@color/rota_gray"/>

                    <TextView
                        android:id="@+id/categoryChip3"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_pill"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:gravity="center"
                        android:text="@string/TextElectronics"
                        android:textSize="12sp"
                        android:textColor="@color/rota_gray"/>

                    <TextView
                        android:id="@+id/categoryChip4"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_pill"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:gravity="center"
                        android:text="@string/TextSpareParts"
                        android:textSize="12sp"
                        android:textColor="@color/rota_gray"/>

                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/explore0Root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="9dp"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/explore0Image"
                    android:layout_width="136dp"
                    android:layout_height="142dp"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/photo_bicycle"
                    android:background="@drawable/bg_photo_slot"
                    android:clipToOutline="true"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="11dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/explore0Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/rota_navy"
                        android:textStyle="bold"
                        tools:text="Bicicleta en buen estado"
                        android:maxLines="2"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/explore0Status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/rota_dark_green"
                        tools:text="Disponible"
                        android:layout_marginTop="6dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:background="@drawable/bg_pale_green"/>

                    <TextView
                        android:id="@+id/explore0Description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/rota_gray"
                        tools:text="Bicicleta todo terreno, funciona muy bien. Solo detalles de uso normales. Ideal para paseos, ejercicio o transporte."
                        android:layout_marginTop="8dp"
                        android:maxLines="3"
                        android:ellipsize="end"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="7dp">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_rota_pin"
                            android:contentDescription="@null"/>

                        <TextView
                            android:id="@+id/explore0Location"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:textSize="12sp"
                            android:textColor="@color/rota_gray"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:ellipsize="end"
                            tools:text="Barranca, Puntarenas"/>

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/explore1Root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="9dp"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/explore1Image"
                    android:layout_width="136dp"
                    android:layout_height="142dp"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/photo_fan"
                    android:background="@drawable/bg_photo_slot"
                    android:clipToOutline="true"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="11dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/explore1Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/rota_navy"
                        android:textStyle="bold"
                        tools:text="Abanico de pedestal"
                        android:maxLines="2"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/explore1Status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/rota_navy"
                        tools:text="Reservado"
                        android:layout_marginTop="6dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:background="@drawable/bg_pale_yellow"/>

                    <TextView
                        android:id="@+id/explore1Description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/rota_gray"
                        tools:text="Abanico de 3 velocidades, en buen estado. Ideal para la casa o la oficina."
                        android:layout_marginTop="8dp"
                        android:maxLines="3"
                        android:ellipsize="end"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="7dp">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_rota_pin"
                            android:contentDescription="@null"/>

                        <TextView
                            android:id="@+id/explore1Location"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:textSize="12sp"
                            android:textColor="@color/rota_gray"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:ellipsize="end"
                            tools:text="El Roble"/>

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/explore2Root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="9dp"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/explore2Image"
                    android:layout_width="136dp"
                    android:layout_height="142dp"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/photo_baby"
                    android:background="@drawable/bg_photo_slot"
                    android:clipToOutline="true"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="11dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/explore2Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/rota_navy"
                        android:textStyle="bold"
                        tools:text="Ropa de bebé"
                        android:maxLines="2"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/explore2Status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/rota_dark_green"
                        tools:text="Disponible"
                        android:layout_marginTop="6dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:background="@drawable/bg_pale_green"/>

                    <TextView
                        android:id="@+id/explore2Description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/rota_gray"
                        tools:text="Ropa de bebé de 0 a 6 meses en excelente estado."
                        android:layout_marginTop="8dp"
                        android:maxLines="3"
                        android:ellipsize="end"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="7dp">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_rota_pin"
                            android:contentDescription="@null"/>

                        <TextView
                            android:id="@+id/explore2Location"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:textSize="12sp"
                            android:textColor="@color/rota_gray"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:ellipsize="end"
                            tools:text="Chacarita"/>

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/explore3Root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="9dp"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/explore3Image"
                    android:layout_width="136dp"
                    android:layout_height="142dp"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/photo_books"
                    android:background="@drawable/bg_photo_slot"
                    android:clipToOutline="true"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="11dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/explore3Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/rota_navy"
                        android:textStyle="bold"
                        tools:text="Libros universitarios"
                        android:maxLines="2"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/explore3Status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/rota_dark_green"
                        tools:text="Disponible"
                        android:layout_marginTop="6dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:background="@drawable/bg_pale_green"/>

                    <TextView
                        android:id="@+id/explore3Description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/rota_gray"
                        tools:text="Varios libros de ingeniería en buen estado."
                        android:layout_marginTop="8dp"
                        android:maxLines="3"
                        android:ellipsize="end"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="7dp">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_rota_pin"
                            android:contentDescription="@null"/>

                        <TextView
                            android:id="@+id/explore3Location"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:textSize="12sp"
                            android:textColor="@color/rota_gray"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:ellipsize="end"
                            tools:text="Barranca, Puntarenas"/>

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>


    <LinearLayout
        android:id="@+id/navRoot"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:orientation="horizontal"
        android:background="@color/rota_white"
        android:elevation="4dp">

        <FrameLayout
            android:id="@+id/navExplore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navIconExplore"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rota_search"
                android:contentDescription="@string/rota_nav_explore"
                android:tint="@color/rota_green"/>

            <View
                android:id="@+id/navLineExplore"
                android:layout_width="29dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pill_on"
                android:visibility="visible"/>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/navPublish"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navIconPublish"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rota_plus_circle"
                android:contentDescription="@string/rota_nav_publish"
                android:tint="@color/rota_gray"/>

            <View
                android:id="@+id/navLinePublish"
                android:layout_width="29dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pill_on"
                android:visibility="gone"/>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/navMessages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navIconMessages"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rota_chat"
                android:contentDescription="@string/rota_nav_messages"
                android:tint="@color/rota_gray"/>

            <View
                android:id="@+id/navLineMessages"
                android:layout_width="29dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pill_on"
                android:visibility="gone"/>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/navRequests"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navIconRequests"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rota_clipboard"
                android:contentDescription="@string/rota_nav_requests"
                android:tint="@color/rota_gray"/>

            <View
                android:id="@+id/navLineRequests"
                android:layout_width="29dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pill_on"
                android:visibility="gone"/>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navIconProfile"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rota_person"
                android:contentDescription="@string/rota_nav_profile"
                android:tint="@color/rota_gray"/>

            <View
                android:id="@+id/navLineProfile"
                android:layout_width="29dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pill_on"
                android:visibility="gone"/>

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
