
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/rota_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:elevation="2dp"
        android:background="@color/rota_white">

        <ImageView
            android:id="@+id/actionBack"
            android:layout_width="26dp"
            android:layout_height="29dp"
            android:src="@drawable/ic_rota_back" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="13dp"
            android:src="@drawable/ic_rota_avatar_small"
            android:background="@drawable/bg_avatar_circle"
            android:padding="5dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chatUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/rota_navy"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Ana" />

            <TextView
                android:id="@+id/chatItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/rota_gray"
                android:textSize="13sp"
                tools:text="Bicicleta en buen estado" />

        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/bubble0Root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start"
                android:layout_marginTop="9dp">

                <TextView
                    android:id="@+id/bubble0Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/rota_navy"
                    tools:text="Hola, ¿la bicicleta todavía está disponible?"
                    android:maxWidth="285dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:background="@drawable/bg_bubble_in" />

                <TextView
                    android:id="@+id/bubble0Time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/rota_gray"
                    tools:text="9:14 a. m."
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="5dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/bubble1Root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginTop="9dp">

                <TextView
                    android:id="@+id/bubble1Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/rota_navy"
                    tools:text="¡Hola! Sí, todavía está disponible."
                    android:maxWidth="285dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:background="@drawable/bg_bubble_out" />

                <TextView
                    android:id="@+id/bubble1Time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/rota_gray"
                    tools:text="9:16 a. m."
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="5dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/bubble2Root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start"
                android:layout_marginTop="9dp">

                <TextView
                    android:id="@+id/bubble2Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/rota_navy"
                    tools:text="¡Qué bueno! Me interesa mucho. ¿Podríamos coordinar para verla y recogerla?"
                    android:maxWidth="285dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:background="@drawable/bg_bubble_in" />

                <TextView
                    android:id="@+id/bubble2Time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/rota_gray"
                    tools:text="9:18 a. m."
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="5dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/bubble3Root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginTop="9dp">

                <TextView
                    android:id="@+id/bubble3Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/rota_navy"
                    tools:text="Claro, podemos vernos. ¿Te queda bien en el Parque de Barranca?"
                    android:maxWidth="285dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:background="@drawable/bg_bubble_out" />

                <TextView
                    android:id="@+id/bubble3Time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/rota_gray"
                    tools:text="9:20 a. m."
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="5dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/bubble4Root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start"
                android:layout_marginTop="9dp">

                <TextView
                    android:id="@+id/bubble4Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/rota_navy"
                    tools:text="Sí, perfecto. ¿Te parece mañana en la tarde?"
                    android:maxWidth="285dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:background="@drawable/bg_bubble_in" />

                <TextView
                    android:id="@+id/bubble4Time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/rota_gray"
                    tools:text="9:22 a. m."
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="5dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/bubble5Root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginTop="9dp">

                <TextView
                    android:id="@+id/bubble5Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/rota_navy"
                    tools:text="Sí, mañana a las 4:00 p. m. está bien para mí."
                    android:maxWidth="285dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:background="@drawable/bg_bubble_out" />

                <TextView
                    android:id="@+id/bubble5Time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/rota_gray"
                    tools:text="9:24 a. m."
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="5dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/bubble6Root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start"
                android:layout_marginTop="9dp">

                <TextView
                    android:id="@+id/bubble6Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/rota_navy"
                    tools:text="Excelente, nos vemos ahí. 👌"
                    android:maxWidth="285dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:background="@drawable/bg_bubble_in" />

                <TextView
                    android:id="@+id/bubble6Time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/rota_gray"
                    tools:text="9:25 a. m."
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="5dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/chatMeeting"
                android:layout_width="270dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="7dp"
                android:padding="12dp"
                android:orientation="vertical"
                android:background="@drawable/bg_bubble_out">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/TextAgreedPoint"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/rota_navy" />

                <TextView
                    android:id="@+id/chatMeetingArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    tools:text="Barranca, Puntarenas"
                    android:textSize="13sp"
                    android:textColor="@color/rota_gray" />

                <TextView
                    android:id="@+id/chatMeetingOpen"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_ghost"
                    android:text="@string/rota_view_point"
                    android:gravity="center"
                    android:textColor="@color/rota_green"
                    android:textStyle="bold"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/bubble7Root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginTop="9dp">

                <TextView
                    android:id="@+id/bubble7Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/rota_navy"
                    tools:text="Perfecto, ahí nos vemos. ¡Muchas gracias!"
                    android:maxWidth="285dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:background="@drawable/bg_bubble_out" />

                <TextView
                    android:id="@+id/bubble7Time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/rota_gray"
                    tools:text="9:27 a. m."
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="5dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:paddingHorizontal="13dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/rota_white"
        android:elevation="6dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_field">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="14dp"
                android:src="@drawable/ic_rota_attach"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/inputChatMessage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/TextTypeMessage"
                android:background="@android:color/transparent"
                android:inputType="textCapSentences"
                android:maxLines="3"
                android:paddingStart="46dp"
                android:paddingEnd="10dp"
                android:textSize="14sp"
                android:textColor="@color/rota_navy" />

        </FrameLayout>

        <ImageView
            android:id="@+id/actionSendMessage"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginStart="9dp"
            android:background="@drawable/bg_pill_on"
            android:src="@drawable/ic_rota_send"
            android:tint="@color/rota_white"
            android:padding="11dp"
            android:contentDescription="@string/TextSend" />

    </LinearLayout>

</LinearLayout>
