<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFBFD">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="21dp">
        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/TextRequests"
            android:textSize="29sp"
            android:textStyle="bold"
            android:textColor="@color/rota_navy" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/rota_requests_subtitle"
            android:textSize="14sp"
            android:textColor="@color/rota_gray" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="19dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_pill">
            <LinearLayout
                android:id="@+id/requestDirection0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_pill"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_rota_box"
                    android:tint="@color/rota_navy"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/rota_received"
                    android:textColor="@color/rota_navy"
                    android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/requestDirection1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_pill_on"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_rota_send"
                    android:tint="@color/rota_white"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/rota_sent"
                    android:textColor="@color/rota_white"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="13dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/requestTab0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:text="@string/rota_pending"
                tools:text="Pendientes (3)"
                android:textSize="12sp"
                android:textColor="@color/rota_gray"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/requestTab1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_on"
                android:gravity="center"
                android:text="@string/rota_accepted"
                tools:text="Aceptadas (2)"
                android:textSize="12sp"
                android:textColor="@color/rota_white"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/requestTab2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:text="@string/TextFinished"
                tools:text="Finalizadas (4)"
                android:textSize="12sp"
                android:textColor="@color/rota_gray"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingTop="2dp"
            android:paddingBottom="12dp">
            <LinearLayout
                android:id="@+id/request0Root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="11dp"
                android:padding="10dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/request0Image"
                    android:layout_width="126dp"
                    android:layout_height="126dp"
                    android:background="@drawable/bg_photo_slot"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null"
                    tools:src="@drawable/photo_books" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="126dp"
                    android:layout_weight="1"
                    android:layout_marginStart="11dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/request0Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/rota_navy"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end"
                        tools:text="Libros de estudio" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_rota_avatar_small"
                            android:background="@drawable/bg_avatar_circle"
                            android:padding="2dp"
                            android:contentDescription="@null" />
                        <TextView
                            android:id="@+id/request0User"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="7dp"
                            android:textColor="@color/rota_navy"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end"
                            tools:text="Sofía" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_rota_clock"
                            android:tint="@color/rota_gray"
                            android:contentDescription="@null" />
                        <TextView
                            android:id="@+id/request0Time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:textSize="12sp"
                            android:textColor="@color/rota_gray"
                            android:maxLines="1"
                            android:ellipsize="end"
                            tools:text="Aceptada hace 3 horas" />
                    </LinearLayout>
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="37dp"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:id="@+id/request0Chat"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_ghost"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_rota_chat"
                                android:tint="@color/rota_gray"
                                android:contentDescription="@null" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="@string/TextViewChat"
                                android:textSize="12sp"
                                android:textColor="@color/rota_gray" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/request0Cancel"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="7dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_red"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_rota_close"
                                android:tint="@color/rota_red"
                                android:contentDescription="@null" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="@string/TextCancel"
                                android:textSize="12sp"
                                android:textColor="@color/rota_red" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/request1Root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="11dp"
                android:padding="10dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/request1Image"
                    android:layout_width="126dp"
                    android:layout_height="126dp"
                    android:background="@drawable/bg_photo_slot"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null"
                    tools:src="@drawable/photo_fan" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="126dp"
                    android:layout_weight="1"
                    android:layout_marginStart="11dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/request1Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/rota_navy"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end"
                        tools:text="Ventilador en buen estado" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_rota_avatar_small"
                            android:background="@drawable/bg_avatar_circle"
                            android:padding="2dp"
                            android:contentDescription="@null" />
                        <TextView
                            android:id="@+id/request1User"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="7dp"
                            android:textColor="@color/rota_navy"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end"
                            tools:text="Matías" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_rota_clock"
                            android:tint="@color/rota_gray"
                            android:contentDescription="@null" />
                        <TextView
                            android:id="@+id/request1Time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:textSize="12sp"
                            android:textColor="@color/rota_gray"
                            android:maxLines="1"
                            android:ellipsize="end"
                            tools:text="Aceptada hace 1 día" />
                    </LinearLayout>
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="37dp"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:id="@+id/request1Chat"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_ghost"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_rota_chat"
                                android:tint="@color/rota_gray"
                                android:contentDescription="@null" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="@string/TextViewChat"
                                android:textSize="12sp"
                                android:textColor="@color/rota_gray" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/request1Cancel"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="7dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_red"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_rota_close"
                                android:tint="@color/rota_red"
                                android:contentDescription="@null" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="@string/TextCancel"
                                android:textSize="12sp"
                                android:textColor="@color/rota_red" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/navRoot"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:orientation="horizontal"
        android:background="@color/rota_white"
        android:elevation="4dp">
        <FrameLayout
            android:id="@+id/navExplore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/navIconExplore"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rota_search"
                android:contentDescription="@string/rota_nav_explore"
                android:tint="@color/rota_gray" />
            <View
                android:id="@+id/navLineExplore"
                android:layout_width="29dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pill_on"
                android:visibility="gone" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/navPublish"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/navIconPublish"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rota_plus_circle"
                android:contentDescription="@string/rota_nav_publish"
                android:tint="@color/rota_gray" />
            <View
                android:id="@+id/navLinePublish"
                android:layout_width="29dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pill_on"
                android:visibility="gone" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/navMessages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/navIconMessages"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rota_chat"
                android:contentDescription="@string/rota_nav_messages"
                android:tint="@color/rota_gray" />
            <View
                android:id="@+id/navLineMessages"
                android:layout_width="29dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pill_on"
                android:visibility="gone" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/navRequests"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/navIconRequests"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rota_clipboard"
                android:contentDescription="@string/rota_nav_requests"
                android:tint="@color/rota_green" />
            <View
                android:id="@+id/navLineRequests"
                android:layout_width="29dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pill_on"
                android:visibility="visible" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/navIconProfile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rota_person"
                android:contentDescription="@string/rota_nav_profile"
                android:tint="@color/rota_gray" />
            <View
                android:id="@+id/navLineProfile"
                android:layout_width="29dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pill_on"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
